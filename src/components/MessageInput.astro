---
---
<div id="message-input-area" class="p-3 border-t border-border bg-card hidden">
  <div class="flex items-end gap-2">
    <div class="flex items-center gap-1">
      <label class="p-2 hover:bg-elevated rounded-lg cursor-pointer transition-colors" title="Send image">
        <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <input id="image-input" type="file" accept="image/*" class="hidden" />
      </label>
      <button id="gif-btn" class="p-2 hover:bg-elevated rounded-lg transition-colors" title="Send GIF">
        <span class="text-xs font-bold text-muted border border-muted rounded px-1">GIF</span>
      </button>
    </div>
    <div class="flex-1 relative">
      <textarea id="message-text" rows="1" placeholder="Type a message..." class="w-full bg-elevated border border-border rounded-lg px-4 py-2.5 text-sm text-text placeholder:text-disabled focus:outline-none focus:border-accent resize-none max-h-32"></textarea>
    </div>
    <button id="send-btn" class="p-2.5 bg-accent hover:bg-accent-hover rounded-lg transition-colors shrink-0" title="Send">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
    </button>
  </div>
</div>
