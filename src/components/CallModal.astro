---
---
<div id="call-modal" class="fixed inset-0 z-[100] bg-black/80 flex items-center justify-center hidden">
  <div class="bg-card border border-border rounded-xl p-8 max-w-sm w-full mx-4 text-center">
    <div id="call-avatar" class="w-20 h-20 rounded-full bg-elevated mx-auto mb-4 flex items-center justify-center text-2xl font-bold"></div>
    <h3 id="call-name" class="text-lg font-medium"></h3>
    <p id="call-status" class="text-sm text-muted mt-1">Calling...</p>
    <div id="call-timer" class="text-sm text-muted mt-1 hidden">00:00</div>
    <div class="mt-6 flex items-center justify-center gap-4">
      <button id="call-accept" class="hidden w-14 h-14 rounded-full bg-online flex items-center justify-center hover:opacity-80 transition-opacity">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      </button>
      <button id="call-end" class="w-14 h-14 rounded-full bg-red-600 flex items-center justify-center hover:opacity-80 transition-opacity">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.516l2.257-1.13a1 1 0 00.502-1.21L8.05 3.684A1 1 0 007.102 3H5z"/></svg>
      </button>
    </div>
    <div id="call-media" class="mt-4 hidden">
      <video id="remote-video" autoplay playsinline class="w-full rounded-lg bg-black"></video>
      <video id="local-video" autoplay playsinline muted class="absolute bottom-4 right-4 w-32 rounded-lg bg-black"></video>
    </div>
  </div>
</div>
