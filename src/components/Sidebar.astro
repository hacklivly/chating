---
---
<aside id="sidebar" class="w-80 max-md:fixed max-md:inset-y-0 max-md:left-0 max-md:z-50 max-md:-translate-x-full max-md:transition-transform bg-card border-r border-border flex flex-col h-full">
  <div class="p-4 border-b border-border">
    <h1 class="text-xl font-bold text-accent font-display">Chating</h1>
    <div class="mt-3 relative">
      <input id="user-search" type="text" placeholder="Search users..." class="w-full bg-elevated border border-border rounded-lg px-4 py-2 text-sm text-text placeholder:text-disabled focus:outline-none focus:border-accent" />
      <div id="search-results" class="absolute top-full left-0 right-0 mt-1 bg-elevated border border-border rounded-lg hidden z-50 max-h-60 overflow-y-auto"></div>
    </div>
  </div>
  <div id="conversations-list" class="flex-1 overflow-y-auto p-2 space-y-1">
    <p class="text-muted text-sm text-center py-8">Loading conversations...</p>
  </div>
  <div class="p-3 border-t border-border">
    <a href="/profile" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-elevated transition-colors">
      <div id="sidebar-avatar" class="w-9 h-9 rounded-full bg-elevated flex items-center justify-center text-sm font-medium"></div>
      <span id="sidebar-name" class="text-sm font-medium truncate"></span>
    </a>
  </div>
</aside>
<div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden" onclick="document.getElementById('sidebar').classList.add('max-md:-translate-x-full');this.classList.add('hidden')"></div>

<script>
async function loadConversations() {
  const res = await fetch('/api/conversations');
  if (!res.ok) return;
  const convos = await res.json();
  const list = document.getElementById('conversations-list')!;
  if (!convos.length) {
    list.innerHTML = '<p class="text-muted text-sm text-center py-8">No conversations yet. Search for users to start chatting.</p>';
    return;
  }
  list.innerHTML = convos.map((c: any) => `
    <button data-user-id="${c.user._id}" class="convo-item w-full flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-elevated transition-colors text-left">
      <div class="relative">
        ${c.user.avatar ? `<img src="${c.user.avatar}" class="w-11 h-11 rounded-full object-cover"/>` : `<div class="w-11 h-11 rounded-full bg-elevated flex items-center justify-center text-sm font-medium">${c.user.name[0].toUpperCase()}</div>`}
        <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-card ${c.user.online ? 'bg-online' : 'bg-disabled'}"></span>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex justify-between items-center">
          <span class="font-medium text-sm truncate">${c.user.name}</span>
          <span class="text-xs text-disabled">${c.time}</span>
        </div>
        <p class="text-xs text-muted truncate">${c.lastMessage}</p>
      </div>
    </button>
  `).join('');

  list.querySelectorAll('.convo-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const uid = (btn as HTMLElement).dataset.userId;
      window.dispatchEvent(new CustomEvent('open-chat', { detail: uid }));
      document.getElementById('sidebar')!.classList.add('max-md:-translate-x-full');
      document.getElementById('sidebar-overlay')!.classList.add('hidden');
    });
  });
}

let searchTimeout: any;
document.getElementById('user-search')!.addEventListener('input', (e) => {
  clearTimeout(searchTimeout);
  const q = (e.target as HTMLInputElement).value.trim();
  const results = document.getElementById('search-results')!;
  if (!q) { results.classList.add('hidden'); return; }
  searchTimeout = setTimeout(async () => {
    const res = await fetch(`/api/users/search?q=${encodeURIComponent(q)}`);
    if (!res.ok) return;
    const users = await res.json();
    if (!users.length) { results.innerHTML = '<p class="p-3 text-sm text-muted">No users found</p>'; results.classList.remove('hidden'); return; }
    results.innerHTML = users.map((u: any) => `
      <button data-uid="${u._id}" class="search-user-btn w-full flex items-center gap-3 px-3 py-2 hover:bg-card transition-colors text-left">
        ${u.avatar ? `<img src="${u.avatar}" class="w-8 h-8 rounded-full object-cover"/>` : `<div class="w-8 h-8 rounded-full bg-card flex items-center justify-center text-xs font-medium">${u.name[0].toUpperCase()}</div>`}
        <span class="text-sm">${u.name}</span>
      </button>
    `).join('');
    results.classList.remove('hidden');
    results.querySelectorAll('.search-user-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-chat', { detail: (btn as HTMLElement).dataset.uid }));
        results.classList.add('hidden');
        (document.getElementById('user-search') as HTMLInputElement).value = '';
        document.getElementById('sidebar')!.classList.add('max-md:-translate-x-full');
        document.getElementById('sidebar-overlay')!.classList.add('hidden');
      });
    });
  }, 300);
});

loadConversations();
setInterval(loadConversations, 10000);
</script>
