---
---
<div id="chat-window" class="flex-1 flex flex-col h-full">
  <!-- Empty state -->
  <div id="chat-empty" class="flex-1 flex items-center justify-center">
    <div class="text-center">
      <div class="w-20 h-20 rounded-full bg-elevated mx-auto mb-4 flex items-center justify-center">
        <svg class="w-10 h-10 text-disabled" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
      <h3 class="text-lg font-medium text-muted">Select a conversation</h3>
      <p class="text-sm text-disabled mt-1">Choose from your conversations or search for a user</p>
    </div>
  </div>

  <!-- Active chat -->
  <div id="chat-active" class="flex-1 flex flex-col h-full hidden">
    <header id="chat-header" class="px-4 py-3 border-b border-border flex items-center gap-3 bg-card">
      <button id="mobile-menu-btn" class="md:hidden p-2 -ml-2 hover:bg-elevated rounded-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div id="chat-user-avatar" class="w-10 h-10 rounded-full bg-elevated flex items-center justify-center text-sm font-medium"></div>
      <div class="flex-1 min-w-0">
        <h2 id="chat-user-name" class="font-medium text-sm truncate"></h2>
        <p id="chat-user-status" class="text-xs text-muted"></p>
      </div>
      <div class="flex items-center gap-2">
        <button id="voice-call-btn" class="p-2 hover:bg-elevated rounded-lg transition-colors" title="Voice call">
          <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </button>
        <button id="video-call-btn" class="p-2 hover:bg-elevated rounded-lg transition-colors" title="Video call">
          <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        </button>
      </div>
    </header>
    <div id="messages-container" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
    <div id="typing-area" class="px-4 hidden">
      <div class="flex items-center gap-1 text-muted text-sm py-1">
        <span class="w-1.5 h-1.5 bg-muted rounded-full animate-bounce" style="animation-delay:0ms"></span>
        <span class="w-1.5 h-1.5 bg-muted rounded-full animate-bounce" style="animation-delay:150ms"></span>
        <span class="w-1.5 h-1.5 bg-muted rounded-full animate-bounce" style="animation-delay:300ms"></span>
        <span class="ml-1">typing...</span>
      </div>
    </div>
  </div>
</div>
